# The chat column: messages and the bars above the list.

message-show-more = Show more
message-no-text = (no text)
message-attachment = Attachment: { $filename } ({ $host })
message-bot-tag = BOT
chat-channel-not-on-screen = That channel is not in the list on screen.
chat-dismissable = { $text }  (click to dismiss)
chat-disconnected = Disconnected. { $message }
chat-reconnect = Reconnect
message-system-tag = SYSTEM
message-op-tag = OP
message-send-failed = Could not send: { $reason }
message-retry = Retry
chat-reply-not-loaded = The original message is not loaded.
chat-new-mark = NEW
chat-new-message = 1 new message since { $since }
chat-new-messages = { $count } new messages since { $since }
chat-new-messages-many = { $count }+ new messages since { $since }
chat-mark-as-read = Mark as read
chat-jump-to-present = Jump to present
chat-jump-new-messages = { $count } new messages — jump to present
reply-deleted = Original message was deleted
reply-unknown = Original message could not be loaded

# The start of a channel.
welcome-channel-title = Welcome to #{ $channel }!
welcome-channel = This is the start of the #{ $channel } channel.
welcome-dm = This is the beginning of your direct message history with { $name }.
welcome-group = Welcome to the beginning of this group.

# System messages. Names are cleaned before they are put in.
system-join = { $name } joined the community.
system-pinned = { $name } pinned a message to this channel.
system-recipient-add = { $name } added { $target } to the group.
system-recipient-remove = { $name } removed { $target } from the group.
system-recipient-left = { $name } left the group.
system-call = { $name } started a call.
system-channel-name = { $name } changed the channel name: { $channel }
system-channel-icon = { $name } changed the channel icon.
system-follow-add = { $name } added { $channel } to this channel. Its most important updates will show up here.
system-thread-created = { $name } started a thread: { $thread }
system-thread-starter = This thread started from a message.
system-unknown = This message type is not supported yet.

# Message times. The order of day, month and year follows the system locale.
time-am = { $time } AM
time-pm = { $time } PM
time-date-and-time = { $date }, { $time }
