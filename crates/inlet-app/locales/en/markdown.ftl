# Message markdown.

markdown-edited = (edited)
markdown-invalid-link = invalid link
markdown-unknown-channel = #unknown-channel
markdown-unknown-user = unknown-user
markdown-unknown-role = unknown-role

markdown-everyone = @everyone
markdown-here = @here
markdown-alert-note = Note
markdown-alert-tip = Tip
markdown-alert-important = Important
markdown-alert-warning = Warning
markdown-alert-caution = Caution
markdown-nav-customize = <id:customize>
markdown-nav-browse = <id:browse>
markdown-nav-guide = <id:guide>
markdown-nav-linked-roles = <id:linked-roles>
markdown-nav-linked-roles-id = <id:linked-roles:{ $id }>
markdown-math = math
markdown-table-cut = Table cut short: only the first rows and columns are shown.

# Timestamps (<t:…>). Dates follow the system's date order.
markdown-month-1 = January
markdown-month-2 = February
markdown-month-3 = March
markdown-month-4 = April
markdown-month-5 = May
markdown-month-6 = June
markdown-month-7 = July
markdown-month-8 = August
markdown-month-9 = September
markdown-month-10 = October
markdown-month-11 = November
markdown-month-12 = December
markdown-weekday-1 = Monday
markdown-weekday-2 = Tuesday
markdown-weekday-3 = Wednesday
markdown-weekday-4 = Thursday
markdown-weekday-5 = Friday
markdown-weekday-6 = Saturday
markdown-weekday-7 = Sunday
markdown-date-long-mdy = { $month } { $day }, { $year }
markdown-date-long-dmy = { $day } { $month } { $year }
markdown-date-at-time = { $date } at { $time }
markdown-weekday-and-date = { $weekday }, { $date }

# Relative timestamps (<t:…:R>), like Intl.RelativeTimeFormat with numeric "auto".
# The -one texts are for a count of 1.
markdown-time-now = now
markdown-time-seconds-future-one = in 1 second
markdown-time-seconds-future = in { $count } seconds
markdown-time-seconds-past-one = 1 second ago
markdown-time-seconds-past = { $count } seconds ago
markdown-time-minutes-future-one = in 1 minute
markdown-time-minutes-future = in { $count } minutes
markdown-time-minutes-past-one = 1 minute ago
markdown-time-minutes-past = { $count } minutes ago
markdown-time-hours-future-one = in 1 hour
markdown-time-hours-future = in { $count } hours
markdown-time-hours-past-one = 1 hour ago
markdown-time-hours-past = { $count } hours ago
markdown-time-days-future-one = tomorrow
markdown-time-days-future = in { $count } days
markdown-time-days-past-one = yesterday
markdown-time-days-past = { $count } days ago
markdown-time-weeks-future-one = next week
markdown-time-weeks-future = in { $count } weeks
markdown-time-weeks-past-one = last week
markdown-time-weeks-past = { $count } weeks ago
markdown-time-months-future-one = next month
markdown-time-months-future = in { $count } months
markdown-time-months-past-one = last month
markdown-time-months-past = { $count } months ago
markdown-time-years-future-one = next year
markdown-time-years-future = in { $count } years
markdown-time-years-past-one = last year
markdown-time-years-past = { $count } years ago
