<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Inlet.app, signed with the hardened runtime
  (the "runtime" option of codesign, see .github/workflows/macos-sign.yml).

  Inlet is not sandboxed. The hardened runtime is on and every exception to it
  stays off: no JIT, no unsigned executable memory, no disabled library
  validation, no DYLD environment variables. gpui ships its Metal shaders
  precompiled in the binary, so Metal needs none of these. (Zed's own
  entitlements allow JIT for its WebAssembly extensions; Inlet has none.)

  network.client only takes effect inside the App Sandbox. It is listed so the
  bundle states what it does, and so a later move to the sandbox keeps working.

  The keychain (the keyring crate, apple-native) needs no entitlement for a
  Developer ID app outside the sandbox.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	  Voice and screen sharing (milestones v0.2 and v0.3). Enable together with
	  the usage strings in Info.plist when the voice code lands. Under the
	  hardened runtime the microphone and the camera stay blocked without these.

	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	-->
</dict>
</plist>
